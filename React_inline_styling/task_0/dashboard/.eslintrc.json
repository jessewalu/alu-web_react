{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "settings": {
    "react": {
      "version": "16.14"
    }
  },
  "rules": {
    "react/prop-types": "off",
    "no-console": "off",
    "no-alert": "off",
    "react/no-unescaped-entities": "off"
  }
}
